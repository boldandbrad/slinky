#!/bin/sh

# slinky: simple dotfile symlink management

VERSION="0.4.0-dev"

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
if [ ! -d "$DOTFILES" ]; then
  echo "Error: '$DOTFILES' is not a directory or cannot be accessed." >&2
  exit 1
fi

MAPPINGS_FILE="$DOTFILES/slinky2.psv"
[ -f "$MAPPINGS_FILE" ] || {
  touch "$MAPPINGS_FILE"
}

_absolute_path() (
  path="$1"
  case "$path" in
    /*)     printf '%s\n' "$path" ;;
    '~')    printf '%s\n' "$HOME" ;;
    '~/'*)  printf '%s/%s\n' "$HOME" "${path#\~/}" ;;
    ./*)    printf '%s/%s\n' "$PWD" "${path#./}" ;;
    *)      printf '%s/%s\n' "$PWD" "$path" ;;
  esac
)

_home_path() (
  path="$1"
  case "$path" in
    "$HOME"|"$HOME"/*)  printf '~%s\n' "${path#"$HOME"}" ;;
    *)                  printf '%s\n' "$path" ;;
  esac
)

_path_exists() (
  [ -e "$1" ] || [ -L "$1" ]
)

_mapping_link() (
  printf '%s\n' "${1%%|*}"
)

_mapping_dotfile() (
  printf '%s\n' "${1#*|}"
)

# TODO: migrate v0 map files
migrate_v0() (
  echo "migrating"
)

help() (
  cat <<'EOF'
usage: slinky <command> [args]

commands:
  add [-p|--path <repo_rel_path>] <src>...    Add and track new files or
                                              directories to dotfiles
  list [-p|--path <repo_rel_path>]            List tracked dotfiles
  move <repo_rel_src> <repo_rel_tgt>          Move a tracked dotfile within the
                                              repo and update its symlink
  drop <repo_rel_path>...                     Drop tracked dotfiles back to
                                              original locations
  find [<path>]                               Find untracked symlinks to the
                                              dotfiles repo
  import <path>...                            Import an untracked dotfile
                                              symlink
  install [-p|--path <repo_rel_path>]         Install symlinks for tracked
                                              dotfiles
  uninstall                                   Uninstall tracked symlinks
  help|-h|--help                              Show this help
  version|-v|--version                        Show version
EOF
)

add_dotfile() (
  source_path="$1"
  repo_rel_path="$2"

  source_path=$(_absolute_path "$source_path")
  if [ ! -e "$source_path" ]; then
    echo "Cannot add '$source_path' to dotfiles: does not exist" >&2
    return 1
  fi

  if [ -L "$source_path" ]; then
    echo "Cannot add '$source_path' to dotfiles: it is a symlink. Try 'slinky import'" >&2
    return 1
  fi

  base=$(basename "$source_path")
  source_home_path=$(_home_path "$source_path")
  norm_repo_rel=${repo_rel_path%/}
  if [ -n "$norm_repo_rel" ]; then
    dotfile_path="$DOTFILES/$norm_repo_rel/$base"
    mapping_entry="$source_home_path|$norm_repo_rel/$base"
  else
    dotfile_path=$DOTFILES/$base
    mapping_entry="$source_home_path|$base"
  fi

  if _path_exists "$dotfile_path"; then
    echo "Skipped, dotfile already exists: $dotfile_path" >&2
    return 0
  fi

  dest_dir="$(dirname "$dotfile_path")"
  if ! mkdir -p "$dest_dir"; then
    echo "Error: Failed to create directory '$dest_dir'" >&2
    return 1
  fi

  if ! mv "$source_path" "$dotfile_path"; then
    echo "Error: Failed to move $source_path to $dotfile_path" >&2
    return 1
  fi

  if ! ln -s "$dotfile_path" "$source_path"; then
    mv "$dotfile_path" "$source_path"
    echo "Error: Failed to create symlink $source_path" >&2
    return 1
  fi

  if ! printf "%s\n" "$mapping_entry" >> "$MAPPINGS_FILE"; then
    rm "$source_path"
    mv "$dotfile_path" "$source_path"
    echo "Error: Failed to write $source_path record to $MAPPINGS_FILE" >&2
    return 1
  fi

  echo "Added dotfile: $source_path > $dotfile_path"
)

list_dotfiles() (
  filter_path="$1"
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;;
    esac
    link_path=$(_mapping_link "$line")
    dotfile_path=$(_mapping_dotfile "$line")

    if [ -n "$filter_path" ]; then
      case "$dotfile_path" in
        "$filter_path"/*) ;;
        "$filter_path") ;;
        *) continue ;;
      esac
    fi

    echo "$link_path > $dotfile_path"
  done < "$MAPPINGS_FILE"
)

move_dotfile() (
  source_path="$1"
  dest_path="$2"
  source_abs_path="$DOTFILES/$source_path"
  dest_abs_path="$DOTFILES/$dest_path"

  if ! _path_exists "$source_abs_path"; then
    echo "Cannot move '$source_abs_path': it does not exist" >&2
    return 1
  fi

  mapping=$(awk -v s="$source_path" -F'|' '$2 == s { print; exit }' "$MAPPINGS_FILE")
  if [ -z "$mapping" ]; then
    echo "Cannot move dotfile '$source_path': no mapping found in '$MAPPINGS_FILE'." >&2
    return 1
  fi

  link_path=$(_mapping_link "$mapping")
  link_abs_path=$(_absolute_path "$link_path")

  if _path_exists "$dest_abs_path"; then
    echo "Cannot move '$source_abs_path' to '$dest_abs_path': it already exists" >&2
    return 1
  fi

  if ! mkdir -p "$(dirname "$dest_abs_path")"; then
    echo "Error: Failed to create destination directory for '$dest_abs_path'" >&2
    return 1
  fi

  if ! mv "$source_abs_path" "$dest_abs_path"; then
    echo "Error: Failed to move $source_abs_path to $dest_abs_path" >&2
    return 1
  fi

  if [ -L "$link_abs_path" ]; then
    rm "$link_abs_path" || {
      echo "Error: Failed to remove existing symlink '$link_abs_path'" >&2
      return 1
    }
  fi

  if ! ln -s "$dest_abs_path" "$link_abs_path"; then
    echo "Error: Failed to create new symlink $link_abs_path" >&2
    return 1
  fi

  tmp=$(mktemp) || {
    mv "$dest_abs_path" "$source_abs_path";
    echo "Error: cannot create temporary file" >&2
    return 1
  }

  if ! awk -v s="$source_path" -F'|' '$2 != s { print }' "$MAPPINGS_FILE" >"$tmp"; then
    rm -f "$tmp"
    mv "$dest_abs_path" "$source_abs_path";
    echo "Error: failed to rewrite mappings" >&2
    return 1
  fi

  if ! mv "$tmp" "$MAPPINGS_FILE"; then
    rm -f "$tmp"
    mv "$dest_abs_path" "$source_abs_path";
    echo "Error: failed to update mappings" >&2
    return 1
  fi

  mapping_entry="$link_path|$dest_path"
  if ! printf "%s\n" "$mapping_entry" >> "$MAPPINGS_FILE"; then
    mv "$dest_abs_path" "$source_abs_path";
    echo "Error: Failed to write $source_path record to $MAPPINGS_FILE" >&2
    return 1
  fi

  echo "Moved dotfile: '$source_path' to '$dest_path' and updated symlink"
)

drop_dotfile() (
  dotfile_path="$1"

  line=$(awk -v s="$dotfile_path" -F'|' '$2 == s { print; exit }' "$MAPPINGS_FILE")
  if [ -z "$line" ]; then
    echo "Skipped, dotfile not tracked: $dotfile_path" >&2
    return 1
  fi

  dotfile_abs_path="$DOTFILES/$dotfile_path"
  if ! _path_exists "$dotfile_abs_path"; then
    echo "Cannot drop '$dotfile_path': dotfile not found at '$dotfile_abs_path'" >&2
    return 1
  fi

  link_path=$(_mapping_link "$line")
  link_abs_path=$(_absolute_path "$link_path")
  if [ -L "$link_abs_path" ]; then
    rm "$link_abs_path" || return 1
  elif [ -e "$link_abs_path" ]; then
    echo "Refusing to replace existing non-symlink: $link_abs_path" >&2
    return 1
  fi

  link_dir=$(dirname "$link_abs_path")
  if ! mkdir -p "$link_dir"; then
    echo "Error: Failed to create directory '$link_dir'" >&2
    return 1
  fi

  if ! mv "$dotfile_abs_path" "$link_abs_path"; then
    echo "Error: Failed to move $dotfile_abs_path to $link_abs_path" >&2
    return 1
  fi
  echo "Dropped dotfile: $dotfile_path > $link_abs_path"

  tmp=$(mktemp) || {
    echo "Error: cannot create temporary file" >&2
    return 1
  }

  if ! awk -v s="$dotfile_path" -F'|' '$2 != s { print }' \
    "$MAPPINGS_FILE" >"$tmp"; then
    rm -f "$tmp"
    echo "Error: failed to rewrite mappings" >&2
    return 1
  fi

  if ! mv "$tmp" "$MAPPINGS_FILE"; then
    rm -f "$tmp"
    echo "Error: failed to update mappings" >&2
    return 1
  fi
)

find_links() (
  search_path="$1"
  if [ -z "$search_path" ]; then
    search_path=~
  fi

  if [ ! -d "$search_path" ]; then
    echo "Cannot search in '$search_path': it is not a directory" >&2
    return 1
  fi

  found_links=$(find "$search_path" -maxdepth 3 -type l -lname "$DOTFILES*" 2>/dev/null)
  [ -n "$found_links" ] || return 0
  while read -r found_link; do
    tracked_dotfile=""
    while IFS= read -r line; do
      case "$line" in ''|'#'* ) continue ;;
      esac

      link_path=$(_mapping_link "$line")
      link_abs_path=$(_absolute_path "$link_path")
      dotfile_path=$(_mapping_dotfile "$line")
      if [ "$found_link" = "$link_abs_path" ]; then
        tracked_dotfile="$dotfile_path"
        break
      fi
    done < "$MAPPINGS_FILE"

    if [ -z "$tracked_dotfile" ]; then
      found_link_dest=$(readlink "$found_link")
      echo "$found_link > $found_link_dest"
    fi
  done << EOF
$found_links
EOF
)

import_link() (
  link_path="$1"
  link_path=$(_absolute_path "$link_path")
  if [ ! -L "$link_path" ]; then
    echo "Cannot import '$link_path': it is not a valid symlink" >&2
    return 1
  fi

  link_dest=$(readlink "$link_path")
  case "$link_dest" in
    "$DOTFILES"/*)
      dotfile_path=${link_dest#"$DOTFILES"/}
      ;;
    "$DOTFILES")
      echo "Cannot import repository directory itself" >&2
      return 1
      ;;
    *)
      echo "Cannot import symlink '$link_path': it does not point to the dotfiles repo" >&2
      return 1
      ;;
  esac

  link_home_path=$(_home_path "$link_path")
  mapping=$(awk -v s="$link_home_path" -F'|' '$1 == s { print; exit }' "$MAPPINGS_FILE")
  if [ -n "$mapping" ]; then
    echo "Cannot import symlink '$link_path': it is already tracked" >&2
    return 1
  fi

  mapping_entry="$link_home_path|$dotfile_path"
  if ! printf "%s\n" "$mapping_entry" >> "$MAPPINGS_FILE"; then
    echo "Error: Failed to write $link_path record to $MAPPINGS_FILE" >&2
    return 1
  fi

  echo "Imported dotfile symlink: $link_path > $dotfile_path"
)

install_links() (
  filter_path="$1"
  install_status=0
  while IFS= read -r line; do
    case "$line" in ''|'#'* ) continue ;;
    esac

    link_path=$(_mapping_link "$line")
    dotfile_path=$(_mapping_dotfile "$line")

    if [ -n "$filter_path" ]; then
      case "$dotfile_path" in
        "$filter_path"/*) ;;
        "$filter_path") ;;
        *) continue ;;
      esac
    fi

    dotfile_abs_path="$DOTFILES/$dotfile_path"
    if [ ! -e "$dotfile_abs_path" ]; then
      echo "Skipped, dotfile not found: $dotfile_abs_path" >&2
      install_status=1
      continue
    fi

    link_abs_path=$(_absolute_path "$link_path")
    if _path_exists "$link_abs_path"; then
      echo "Skipped, symlink already exists: $link_abs_path" >&2
      install_status=1
      continue
    fi

    if ! mkdir -p "$(dirname "$link_abs_path")"; then
      echo "Error: Failed to create directory '$dest_dir'" >&2
      install_status=1
      continue
    fi

    if ! ln -s "$dotfile_abs_path" "$link_abs_path"; then
      echo "Error: Failed to create symlink $link_abs_path" >&2
      install_status=1
      continue
    fi

    if [ -L "$link_abs_path" ]; then
      echo "Created symlink: $link_abs_path"
    else
      echo "Failed creating symlink: $link_abs_path > $dotfile_abs_path"
    fi
  done < "$MAPPINGS_FILE"
  return "$install_status"
)

uninstall_links() (
  while IFS= read -r line; do
    case "$line" in ''|'#'* ) continue ;;
    esac
    link_path=$(_mapping_link "$line")
    link_abs_path=$(_absolute_path "$link_path")
    if [ -L "$link_abs_path" ]; then
      rm "$link_abs_path" || return 1
      echo "Removed symlink: $link_abs_path"
    elif [ -e "$link_abs_path" ]; then
      echo "Refusing to remove existing non-symlink: $link_abs_path" >&2
      return 1
    fi
  done < "$MAPPINGS_FILE"
)

# TODO: do map file migrations
# migrate_v0

status=0
case "$1" in
  add)
    shift
    repo_rel_path=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -p|--path)
          if [ -n "$2" ] && [ "${2#-}" = "$2" ]; then
            repo_rel_path="$2"
            shift 2
          else
            echo "Error: -p/--path requires a path argument" >&2
            exit 1
          fi
          ;;
        -*)
          echo "Error: Unknown option '$1'" >&2
          exit 1
          ;;
        *)
          add_dotfile "$1" "$repo_rel_path" || status=1
          shift
          ;;
      esac
    done
    ;;
  list)
    shift
    filter_path=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -p|--path)
          if [ -n "$2" ] && [ "${2#-}" = "$2" ]; then
            filter_path="$2"
            shift 2
          else
            echo "Error: -p/--path requires a path argument" >&2
            exit 1
          fi
          ;;
        -*)
          echo "Error: Unknown option '$1'" >&2
          exit 1
          ;;
        *)
          echo "Error: Unknown argument '$1'" >&2
          exit 1
          ;;
      esac
    done
    list_dotfiles "$filter_path" || status=1
    ;;
  move)
    shift
    if [ $# -eq 2 ]; then
      move_dotfile "$1" "$2" || status=1
    else
      help && status=1
    fi
    ;;
  drop)
    shift
    if [ $# -ge 1 ]; then
      for repo_rel_path in "$@"; do
        drop_dotfile "$repo_rel_path" || status=1
      done
    else
      help && status=1
    fi
    ;;
  find)
    shift
    if [ $# -eq 1 ]; then
      find_links "$1" || status=1
    elif [ $# -eq 0 ]; then
      find_links || status=1
    else
      help && status=1
    fi
    ;;
  import)
    shift
    if [ $# -gt 0 ]; then
      while [ $# -gt 0 ]; do
        import_link "$1" || status=1
        shift
      done
    else
      help && status=1
    fi
    ;;
  install)
    shift
    filter_path=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -p|--path)
          if [ -n "$2" ] && [ "${2#-}" = "$2" ]; then
            filter_path="$2"
            shift 2
          else
            echo "Error: -p/--path requires a path argument" >&2
            exit 1
          fi
          ;;
        -*)
          echo "Error: Unknown option '$1'" >&2
          exit 1
          ;;
        *)
          echo "Error: Unknown argument '$1'" >&2
          exit 1
          ;;
      esac
    done
    install_links "$filter_path" || status=1
    ;;
  uninstall)
    uninstall_links || status=1
    ;;
  help|"-h"|"--help")
    help
    ;;
  version|"-v"|"--version")
    echo "slinky version $VERSION"
    ;;
  *)
    help && status=1
    ;;
esac
exit "$status"
