#!/bin/sh

# slinky: simple dotfile symlink management

VERSION="0.3.0-dev"

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
if [ ! -d "$DOTFILES" ]; then
  echo "Error: DOTFILES ('$DOTFILES') is not a directory or cannot be accessed." >&2
  exit 1
fi

MAPPINGS_FILE="$DOTFILES/slinky.psv"
[ -f "$MAPPINGS_FILE" ] || {
  echo "" > "$MAPPINGS_FILE";
  echo "Created '$MAPPINGS_FILE'"
}

tilde_expand() {
  v="$1"
  if [ "$v" = "~" ]; then
    echo "$HOME"
  else
    rest=$(printf '%s' "$v" | sed 's#^~\/##')
    if [ "$rest" != "$v" ]; then
      echo "$HOME/$rest"
    else
      echo "$v"
    fi
  fi
}

help() {
  cat <<'EOF'
usage: slinky <command> [args]

commands:
  add [-p|--path <repo_rel_path>] <src>...    Add and track new files or
                                              directories to dotfiles
  list [-p|--path <repo_rel_path>]            List tracked dotfiles
  move <repo_rel_src> <repo_rel_tgt>          Move a tracked dotfile within the
                                              repo and update its symlink
  drop <repo_rel_path>...                     Drop tracked dotfiles back to
                                              original locations
  find [<path>]                               Find untracked symlinks to the
                                              dotfiles repo
  import <path>...                            Import an untracked dotfile
                                              symlink
  install [-p|--path <repo_rel_path>]         Install symlinks for tracked
                                              dotfiles
  uninstall                                   Uninstall tracked symlinks
  help|-h|--help                              Show this help
  version|-v|--version                        Show version
EOF
}

add_dotfiles() {
  input_path="$1"
  repo_rel_path="$2"

  source_path="$(cd "$(dirname "$input_path")" && pwd)/$(basename "$input_path")"
  if [ ! -e "$source_path" ]; then
    echo "Cannot add '$source_path' to dotfiles: does not exist" >&2; return
  fi

  base=$(basename "$source_path")

  dest_path=""
  mapping_entry=""
  home_tgt=""
  case "$source_path" in
    "$HOME"*)
      rel_path="${source_path#"$HOME"}"
      home_tgt="~${rel_path}"
      ;;
    *)
      home_tgt="$source_path"
      ;;
  esac

  if [ -n "$repo_rel_path" ]; then
    norm_repo_rel="${repo_rel_path%/}"
    if [ -n "$norm_repo_rel" ]; then
      dest_path="$DOTFILES/$norm_repo_rel/$base"
      mapping_entry="$norm_repo_rel/$base|$home_tgt"
    else
      dest_path="$DOTFILES/$base"
      mapping_entry="$base|$home_tgt"
    fi
  else
    dest_path="$DOTFILES/$base"
    mapping_entry="$base|$home_tgt"
  fi

  if [ -e "$dest_path" ]; then
    echo "Cannot add '$source_path' to dotfiles: '$dest_path' already exists" >&2; return
  fi

  dest_dir="$(dirname "$dest_path")"
  if [ ! -e "$dest_path" ]; then
    mkdir -p "$dest_dir"
  fi

  mv "$source_path" "$dest_path"
  ln -sn "$dest_path" "$source_path"

  printf "%s\n" "$mapping_entry" >> "$MAPPINGS_FILE"

  echo "Added dotfile '$dest_path' via symlink at '$source_path'"
}

list_dotfiles() {
  filter_path="$1"
  while IFS= read -r line; do
    case "$line" in
      ''|'#'*) continue ;;
    esac
    src=$(printf '%s' "$line" | cut -d'|' -f1)
    tgt=$(printf '%s' "$line" | cut -d'|' -f2-)

    if [ -n "$filter_path" ]; then
      case "$src" in
        "$filter_path"/*) ;;
        "$filter_path") ;;
        *) continue ;;
      esac
    fi

    echo "$src > $tgt"
  done < "$MAPPINGS_FILE"
}

move_dotfile() {
  source_path="$1"
  dest_path="$2"
  source_abs_path="$DOTFILES/$source_path"
  dest_abs_path="$DOTFILES/$dest_path"

  if [ ! -e "$source_abs_path" ]; then
    echo "Cannot move '$source_abs_path': it does not exist" >&2; return
  fi

  mapping=$(awk -v s="$source_path" -F'|' '$1 == s { print; exit }' "$MAPPINGS_FILE")
  if [ -z "$mapping" ]; then
    echo "Cannot move dotfile '$source_path': no mapping found in '$MAPPINGS_FILE'." >&2; return
  fi
  link_path=$(printf '%s' "$mapping" | cut -d'|' -f2-)
  link_abs_path="$(tilde_expand "$link_path")"

  if [ -e "$dest_abs_path" ]; then
    echo "Cannot move '$source_abs_path' to '$dest_abs_path': it already exists" >&2; return
  fi

  mv "$source_abs_path" "$dest_abs_path"

  if [ -L "$link_abs_path" ]; then
    rm "$link_abs_path"
  fi
  ln -sn "$dest_abs_path" "$link_abs_path"

  tmp=$(mktemp)
  awk -v s="$source_path" -F'|' '$1 != s { print }' "$MAPPINGS_FILE" > "$tmp" && mv "$tmp" "$MAPPINGS_FILE"
  mapping_entry="$dest_path|$link_path"
  printf "%s\n" "$mapping_entry" >> "$MAPPINGS_FILE"

  echo "Moved dotfile '$source_path' to '$dest_path' and updated symlink"
}

drop_dotfiles() {
  repo_rel_path="$1"

  line=$(awk -v s="$repo_rel_path" -F'|' '$1 == s { print; exit }' "$MAPPINGS_FILE")
  if [ -z "$line" ]; then
    echo "Cannot drop dotfile '$repo_rel_path': no mapping found in '$MAPPINGS_FILE'." >&2; return
  fi
  src=$(printf '%s' "$line" | cut -d'|' -f1)
  tgt=$(printf '%s' "$line" | cut -d'|' -f2-)

  abs_src="$DOTFILES/$src"
  abs_tgt="$(tilde_expand "$tgt")"

  if [ -L "$abs_tgt" ] || [ -e "$abs_tgt" ]; then
    rm -f "$abs_tgt" 2>/dev/null
  fi

  mkdir -p "$(dirname "$abs_tgt")"
  if [ -e "$abs_src" ]; then
    mv "$abs_src" "$abs_tgt"
    echo "Dropped dotfile '$repo_rel_path' and moved it back to '$abs_tgt'"
  else
    echo "Cannot drop dotfile '$repo_rel_path': expected dotfiles content not found at '$abs_src'" >&2
  fi

  tmp=$(mktemp)
  awk -v s="$repo_rel_path" -F'|' '$1 != s { print }' "$MAPPINGS_FILE" > "$tmp" && mv "$tmp" "$MAPPINGS_FILE"
}

find_links() {
  search_path="$1"
  if [ -z "$search_path" ]; then
    search_path=~
  fi

  if [ ! -d "$search_path" ]; then
    echo "Cannot search in '$search_path': it is not a directory" >&2; return
  fi

  links=$(find "$search_path" -maxdepth 3 -type l -lname "$DOTFILES*" 2>/dev/null)
  while read -r link; do
    repo_rel_path=""
    while IFS= read -r mapping; do
      src=$(printf '%s' "$mapping" | cut -d'|' -f1)
      tgt=$(printf '%s' "$mapping" | cut -d'|' -f2-)
      abs_tgt="$(tilde_expand "$tgt")"

      if [ "$link" = "$abs_tgt" ]; then
        repo_rel_path="$src"
        break
      fi
    done < "$MAPPINGS_FILE"

    if [ -z "$repo_rel_path" ]; then
      dest=$(readlink "$link")
      echo "$link > $dest"
    fi
  done << EOF
$links
EOF
}

import_links() {
  link_path="$1"
  if [ ! -L "$link_path" ]; then
    echo "Cannot import '$link_path': it is not a valid symlink" >&2; return
  fi

  link_dest=$(readlink "$link_path")
  case "$link_dest" in
    "$DOTFILES"*)
      repo_rel_path="${link_dest#"$DOTFILES/"}"
      ;;
    *)
      echo "Cannot import symlink '$link_path': it does not point to the dotfiles repo" >&2; return
      ;;
  esac

  case "$link_path" in
    "$HOME"*)
      rel_path="${link_path#"$HOME"}"
      link_short_path="~${rel_path}"
      ;;
    *)
      link_short_path="$source_path"
      ;;
  esac

  mapping=$(awk -v s="$link_short_path" -F'|' '$2 == s { print; exit }' "$MAPPINGS_FILE")
  if [ -n "$mapping" ]; then
    echo "Cannot import symlink '$link_path': it is already tracked" >&2; return
  fi

  mapping_entry="$repo_rel_path|$link_short_path"
  printf "%s\n" "$mapping_entry" >> "$MAPPINGS_FILE"

  echo "Imported dotfile symlink '$link_path'"
}

install_links() {
  filter_path="$1"
  echo "Installing dotfile symlinks from '$MAPPINGS_FILE'"

  while IFS= read -r line; do
    case "$line" in
      ''|'#'* ) continue ;;
    esac

    src=$(printf '%s' "$line" | cut -d'|' -f1)
    tgt=$(printf '%s' "$line" | cut -d'|' -f2-)

    if [ -n "$filter_path" ]; then
      case "$src" in
        "$filter_path"/*) ;;
        "$filter_path") ;;
        *) continue ;;
      esac
    fi

    abs_src="$DOTFILES/$src"
    abs_tgt="$(tilde_expand "$tgt")"
    if [ ! -e "$abs_src" ]; then
      echo "  Source not found: '$abs_src'" >&2
      continue
    fi

    if [ -e "$abs_tgt" ] || [ -L "$abs_tgt" ]; then
      echo "  Target exists: '$abs_tgt'" >&2
      continue
    fi

    mkdir -p "$(dirname "$abs_tgt")"
    ln -s "$abs_src" "$abs_tgt" || echo "  Failed linking $abs_src > $abs_tgt" >&2
  done < "$MAPPINGS_FILE"
}

uninstall_links() {
  while IFS= read -r line; do
    case "$line" in ''|'#'* ) continue ;;
    esac
    src=$(printf '%s' "$line" | cut -d'|' -f1)
    tgt=$(printf '%s' "$line" | cut -d'|' -f2-)
    abs_tgt="$(tilde_expand "$tgt")"
    if [ -L "$abs_tgt" ] || [ -e "$abs_tgt" ]; then
      rm -f "$abs_tgt" 2>/dev/null
    fi
  done < "$MAPPINGS_FILE"

  echo "Uninstalled dotfile symlinks tracked in $MAPPINGS_FILE by deleting them"
}

case "$1" in
  add)
    shift
    repo_rel_path=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -p|--path)
          if [ -n "$2" ] && [ "${2#-}" = "$2" ]; then
            repo_rel_path="$2"
            shift 2
          else
            echo "Error: -p/--path requires a path argument" >&2
            exit 1
          fi
          ;;
        -*)
          echo "Error: Unknown option '$1'" >&2
          exit 1
          ;;
        *)
          add_dotfiles "$1" "$repo_rel_path"
          shift
          ;;
      esac
    done
    ;;
  list)
    shift
    filter_path=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -p|--path)
          if [ -n "$2" ] && [ "${2#-}" = "$2" ]; then
            filter_path="$2"
            shift 2
          else
            echo "Error: -p/--path requires a path argument" >&2
            exit 1
          fi
          ;;
        -*)
          echo "Error: Unknown option '$1'" >&2
          exit 1
          ;;
        *)
          echo "Error: Unknown argument '$1'" >&2
          exit 1
          ;;
      esac
    done
    list_dotfiles "$filter_path"
    ;;
  move)
    shift
    if [ $# -eq 2 ]; then
      move_dotfile "$1" "$2"
    else
      help
    fi
    ;;
  drop)
    shift
    if [ $# -ge 1 ]; then
      for repo_rel_path in "$@"; do
        drop_dotfiles "$repo_rel_path"
      done
    else
      help
    fi
    ;;
  find)
    shift
    if [ $# -eq 1 ]; then
      find_links "$1"
    elif [ $# -eq 0 ]; then
      find_links
    else
      help
    fi
    ;;
  import)
    shift
    while [ $# -gt 0 ]; do
      import_links "$1"
      shift
    done
    ;;
  install)
    shift
    filter_path=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -p|--path)
          if [ -n "$2" ] && [ "${2#-}" = "$2" ]; then
            filter_path="$2"
            shift 2
          else
            echo "Error: -p/--path requires a path argument" >&2
            exit 1
          fi
          ;;
        -*)
          echo "Error: Unknown option '$1'" >&2
          exit 1
          ;;
        *)
          echo "Error: Unknown argument '$1'" >&2
          exit 1
          ;;
      esac
    done
    install_links "$filter_path"
    ;;
  uninstall)
    uninstall_links
    ;;
  help|"-h"|"--help")
    help
    ;;
  version|"-v"|"--version")
    echo "slinky version $VERSION"
    ;;
  *)
    help
    ;;
esac
